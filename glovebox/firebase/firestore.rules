rules_version = '2';
// Glovebox Firestore rules. Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in with a verified email that's on the allow list.
    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/allowed/$(request.auth.token.email.lower()));
    }

    // The allow list: one document per email address (lowercase), added by hand in the console.
    // People can check their own entry; nobody can change the list from the app.
    match /allowed/{email} {
      allow read: if request.auth != null && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    // Each person's own garage: vehicles, records and receipt photos. Nobody else can see it.
    match /users/{userId}/{document=**} {
      allow read, write: if isMember() && request.auth.uid == userId;
    }
  }
}
